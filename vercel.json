{
  "version": 2,
  "name": "ganadero-ad",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/frontend/public/index.html",
      "destination": "/index.html"
    },
    {
      "source": "/frontend/index.html",
      "destination": "/index.html"
    },
    {
      "source": "/frontend",
      "destination": "/index.html"
    },
    {
      "source": "/frontend/public/manifest.webmanifest",
      "destination": "/manifest.webmanifest"
    },
    {
      "source": "/frontend/public/sw.js",
      "destination": "/sw.js"
    },
    {
      "source": "/frontend/public/icon.svg",
      "destination": "/icon.svg"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "source": "/(.*)manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)sw.js",
      "headers": [
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        },
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)bundle.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}