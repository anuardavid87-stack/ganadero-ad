# ==============================================================================
# VARIABLES DE ENTORNO - INTEGRACIÓN WHATSAPP CLOUD API (META) Y BASE DE DATOS
# ==============================================================================
# Copia este archivo como `.env.local` o configura estas variables en tu panel
# de despliegue (Vercel / Railway / Render).

# 1. Token secreto personalizado que configuras en Meta App Dashboard > WhatsApp > Configuration
WHATSAPP_VERIFY_TOKEN="mi_token_secreto_verificacion_ganadero_2026"

# 2. Token de acceso (System User Permanent Token o Temporal) de Meta Graph API
WHATSAPP_ACCESS_TOKEN="EAAGm0PX4ZCpsBA..."

# 3. ID del número de teléfono de WhatsApp Business (Phone Number ID en Meta Developers)
WHATSAPP_PHONE_NUMBER_ID="109876543210987"

# 4. Números autorizados en la Whitelist (formato internacional sin '+', separados por coma)
WHATSAPP_AUTHORIZED_NUMBERS="573001234567,573109876543"

# 5. Credenciales de conexión a la Base de Datos (Supabase PostgreSQL REST)
SUPABASE_URL="https://vddfdaaddgbdlcywqfrd.supabase.co"
SUPABASE_ANON_KEY="tu_supabase_service_role_o_anon_key_aqui"
